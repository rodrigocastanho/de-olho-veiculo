<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.com.devnattiva.deolhoveiculo.TelaSobreApp">


    <TextView
            android:id="@+id/txt_sobre_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sobreApp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="28dp"
            android:textAlignment="textStart"
            android:textSize="18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintVertical_bias="0.222" />

    <TextView
        android:id="@+id/txt_versao_sobre_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/versao"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_sobre_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txt_desenvolvido_sobre_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/desenvolvido"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginTop="10sp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_versao_sobre_app"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
